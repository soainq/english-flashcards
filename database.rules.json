{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        "progress": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length <= 5000000"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
